{
	"name": "music-vote",
	"type": "module",
	"private": true,
	"engines": {
		"bun": ">=1.4.2"
	},
	"scripts": {
		"dev": "bun --hot backend/server.ts",
		"build": "bun run scripts/build.ts",
		"start": "NODE_ENV=production bun backend/server.ts",
		"test": "bun test backend shared frontend",
		"test:e2e": "playwright test",
		"test:e2e:ssr": "playwright test --config=playwright.ssr.config.ts",
		"bootstrap": "bash scripts/bootstrap.sh",
		"premerge": "bash scripts/premerge.sh",
		"db:migrate": "prisma migrate dev && prisma generate",
		"db:reset": "prisma migrate reset",
		"postinstall": "prisma generate",
		"verify": "bun check && bun lint && bun fmt --check && DATABASE_URL=${DATABASE_URL:-file:./dev.db} bun x --no-install knip && bun run test --parallel && PORT=${PLAYWRIGHT_PORT:-3100} CI=1 bun run test:e2e && PORT=${PLAYWRIGHT_PORT:-3100} CI=1 bun run test:e2e:ssr",
		"pm": "bash scripts/premerge.sh"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@tailwindcss/cli": "4.3.3",
		"@tanstack/react-devtools": "^0.10.12",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-query-devtools": "^5.102.7",
		"@types/bun": "1.4.0",
		"@types/node": "^26.4.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"bun-plugin-tailwind": "^0.1.2",
		"daisyui": "5.7.20",
		"knip": "^6.32.3",
		"prisma": "7",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lightpanda/browser": "1.3.2",
		"@prisma/client": "7",
		"@strudel/codemirror": "1.3.0",
		"@strudel/draw": "1.2.6",
		"@strudel/transpiler": "1.2.6",
		"@strudel/web": "1.3.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.18",
		"@trpc/client": "11.18.0",
		"@trpc/server": "11.18.0",
		"@trpc/tanstack-react-query": "11.18.0",
		"better-auth": "1.7.1",
		"dotenv": "^17.4.2",
		"isbot": "^5.2.1",
		"prisma-adapter-bun-sqlite": "^0.8.0",
		"qrcode": "^1.5.4",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.4.3"
	},
	"trustedDependencies": [
		"@lightpanda/browser",
		"bun"
	],
	"patchedDependencies": {
		"@kabelsalat/web@0.4.1": "scripts/patches/@kabelsalat%2Fweb@0.4.1.patch"
	}
}
