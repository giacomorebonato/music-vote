generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "./generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  rooms         Room[]
}

model Room {
  id              String           @id @default(cuid())
  hostId          String
  host            User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bpm             Int
  lengthSec       Int
  pollIntervalSec Int
  pollOpenSec     Int              @default(45)
  genre           String
  status          String
  currentCode     String?
  currentVersionId String?
  grooveLocked    Boolean          @default(false)
  stateDoc        Json
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  textEnabled Boolean @default(true)
  recordingsEnabled Boolean @default(false)
  momentsEnabled Boolean @default(false)
  sampleApproval Boolean @default(true)
  endedAt DateTime?
  lastMomentAt DateTime?
  directions Direction[]
  recordings Recording[]
  moments Moment[]
  polls           Poll[]
  patternVersions PatternVersion[]
}

model Poll {
  id            String    @id @default(cuid())
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seq           Int
  kind          String
  question      String
  options       Json
  openedAt      DateTime?
  closesAt      DateTime?
  status        String
  dimensionKey String?
  catalogVersion Int?
  context Json?
  winningOption String?
  deliveryStatus String?
  closedAt      DateTime?
  resolvedAt    DateTime?
  votes         Vote[]

  @@unique([roomId, seq])
  @@unique([roomId, dimensionKey])
}

model Vote {
  id           String @id @default(cuid())
  pollId       String
  poll         Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  sessionToken String
  choice       String

  @@unique([pollId, sessionToken])
}

model PatternVersion {
  id        String    @id @default(cuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  code      String
  stateDoc  Json?
  source    String
  context Json?
  baseVersionId String?
  status    String
  appliedAt DateTime?
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Account {
  id                    String   @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Direction {
  revokedThrough Int @default(0)
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessionToken String
  revision Int @default(0)
  text String
  interpretation String
  status String @default("active")
  outcome String @default("received")
  updatedAt DateTime @updatedAt
  revisions DirectionRevision[]
  @@unique([roomId, sessionToken])
}
model DirectionRevision {
  requestId String? @unique
  id String @id @default(cuid())
  directionId String
  direction Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  revision Int
  text String
  interpretation String
  createdAt DateTime @default(now())
  @@unique([directionId, revision])
}
model Recording {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessionToken String
  requestId String
  use String
  status String @default("processing")
  reason String?
  trimStart Float @default(0)
  trimEnd Float @default(3)
  duration Float?
  createdAt DateTime @default(now())
  appliedAt DateTime?
  expiresAt DateTime?
  @@unique([roomId, sessionToken, requestId])
  @@index([roomId, status, createdAt])
}
model Moment {
  requestId String? @unique
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessionToken String
  action String
  status String @default("queued")
  createdAt DateTime @default(now())
  appliedAt DateTime?
  @@index([roomId, status, createdAt])
}
