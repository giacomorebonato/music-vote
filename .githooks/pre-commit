#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

bun run check --staged
bun run lint --staged
bun run fmt --staged

# Also cover merges finished with `git commit` after --no-commit or conflicts.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
	bash .githooks/pre-merge-commit
fi
