#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Gate pushes to main even when a fast-forward or manual merge bypassed the merge hook.
pushes_main=false
while read -r local_ref local_oid remote_ref remote_oid; do
	if [ "$remote_ref" = refs/heads/main ] && ! [[ "$local_oid" =~ ^0+$ ]]; then
		pushes_main=true
		# Tests must describe the exact commit being published.
		if [ "$local_oid" != "$(git rev-parse HEAD)" ] || [ -n "$(git status --porcelain)" ]; then
			echo "Push main from its commit with a clean working tree so tests verify the pushed code." >&2
			exit 1
		fi
	fi
done
if [ "$pushes_main" = true ]; then
	bun run verify
else
	bun check
	bun lint
	bun fmt --check
	DATABASE_URL="${DATABASE_URL:-file:./dev.db}" bun x --no-install knip
	bun run test --parallel
fi
