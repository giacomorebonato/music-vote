diff --git a/backend/db/client.ts b/backend/db/client.ts
new file mode 100644
index 0000000..2227e0f
--- /dev/null
+++ b/backend/db/client.ts
@@ -0,0 +1,23 @@
+import { resolve } from 'node:path'
+import { PrismaBunSqlite } from 'prisma-adapter-bun-sqlite'
+import { PrismaClient } from '../../prisma/generated/client'
+
+// Prisma CLI resolves relative `file:./` URLs against the schema directory
+// (prisma/). bun:sqlite resolves them against the CWD instead, which would
+// point at a different (empty) file in dev/test. Normalize relative paths to
+// absolute, anchored on the prisma dir, so the adapter reads the same DB the
+// migrations were applied to. Absolute URLs (e.g. prod `file:/data/prod.db`)
+// are passed through unchanged.
+function resolveDbUrl(raw: string): string {
+	if (!raw.startsWith('file:./')) return raw
+	const rel = raw.slice('file:'.length)
+	return `file:${resolve(import.meta.dir, '..', '..', 'prisma', rel)}`
+}
+
+const prisma = new PrismaClient({
+	adapter: new PrismaBunSqlite({
+		url: resolveDbUrl(process.env.DATABASE_URL ?? 'file:./dev.db'),
+	}),
+})
+
+export { prisma }
diff --git a/backend/normalize-trpc-request.ts b/backend/normalize-trpc-request.ts
new file mode 100644
index 0000000..c81d418
--- /dev/null
+++ b/backend/normalize-trpc-request.ts
@@ -0,0 +1,24 @@
+export const TRPC_ENDPOINT = '/api/trpc'
+
+/**
+ * tRPC's fetch adapter expects the procedure path encoded with dots
+ * (`/api/trpc/notes.list`). Some callers/links send slash-separated paths
+ * (`/api/trpc/notes/list`). Normalize slash-separated paths back to dots so
+ * the adapter routes them. The bare endpoint (`/api/trpc` with no trailing
+ * path, used by batch links that pass procedures via query/body) is passed
+ * through unchanged.
+ */
+export function normalizeTrpcRequest(req: Request, url: URL): Request {
+	const afterEndpoint = url.pathname.slice(TRPC_ENDPOINT.length)
+	if (!afterEndpoint.includes('/')) {
+		return req
+	}
+	const normalizedPath = afterEndpoint
+		.replace(/\//g, '.')
+		.replace(/^\.+|\.+$/g, '')
+	const newUrl = new URL(
+		`${TRPC_ENDPOINT}${normalizedPath ? `/${normalizedPath}` : ''}${url.search}`,
+		url.origin,
+	)
+	return new Request(newUrl, req)
+}
diff --git a/backend/server.ts b/backend/server.ts
new file mode 100644
index 0000000..e439fa6
--- /dev/null
+++ b/backend/server.ts
@@ -0,0 +1,104 @@
+import { auth } from '@backend/auth/auth'
+import {
+	normalizeTrpcRequest,
+	TRPC_ENDPOINT,
+} from '@backend/normalize-trpc-request'
+import { createPrerenderHandler } from '@backend/ssr/prerender'
+import { createContext } from '@backend/trpc/context'
+import { appRouter } from '@backend/trpc/root'
+import { PUBLIC_SSR_PATHS } from '@shared/ssr-paths'
+import { fetchRequestHandler } from '@trpc/server/adapters/fetch'
+
+const isDev = process.env.NODE_ENV !== 'production'
+const port = Number(process.env.PORT ?? 3000)
+
+let devIndex: unknown
+if (isDev) {
+	devIndex = (await import('../frontend/index.html')).default
+}
+
+async function serveDistFile(pathname: string): Promise<Response | null> {
+	if (pathname.includes('..')) return null
+	const file = Bun.file(`dist${pathname}`)
+	if (await file.exists()) return new Response(file)
+	return null
+}
+
+// Prod-only bot prerender (port of fastify-prerender-plugin, adapted to Bun.serve).
+// Dev keeps the HTMLBundle routes + HMR; no prerendering.
+let prerender: ReturnType<typeof createPrerenderHandler> | null = null
+if (!isDev) {
+	prerender = createPrerenderHandler({
+		urls: PUBLIC_SSR_PATHS,
+		port,
+		cacheDir: process.env.SSR_CACHE_DIR || undefined,
+	})
+}
+
+// Dispatch /api/* requests (tRPC + better-auth). Used both from the dev
+// `routes` map (so the `/*` HTMLBundle wildcard doesn't shadow API POSTs with
+// 405) and from the prod `fetch` handler.
+async function handleApi(req: Request): Promise<Response> {
+	const url = new URL(req.url)
+	if (url.pathname.startsWith(TRPC_ENDPOINT)) {
+		const trpcReq = normalizeTrpcRequest(req, url)
+		return fetchRequestHandler({
+			endpoint: TRPC_ENDPOINT,
+			req: trpcReq,
+			router: appRouter,
+			createContext,
+		})
+	}
+	if (url.pathname.startsWith('/api/auth')) {
+		return auth.handler(req)
+	}
+	return new Response(JSON.stringify({ error: 'Not found' }), {
+		status: 404,
+		headers: { 'content-type': 'application/json' },
+	})
+}
+
+const server = Bun.serve({
+	port,
+	...(isDev
+		? {
+				// Dev: register /api/* as explicit function routes so they take
+				// precedence over the `/*` HTMLBundle wildcard. Bun matches `routes`
+				// before `fetch`, and a wildcard HTMLBundle route only accepts
+				// GET/HEAD (POST -> 405), which previously broke auth signup and
+				// tRPC mutations. The `/*` route serves the SPA shell + HMR for any
+				// other path so new client routes need no server change.
+				routes: {
+					'/api/auth/*': handleApi,
+					'/api/trpc/*': handleApi,
+					'/*': devIndex as unknown as import('bun').HTMLBundle,
+				},
+				development: { hmr: true, console: true },
+			}
+		: {
+				development: false,
+			}),
+	async fetch(req) {
+		// Bot prerender runs first (like the plugin's onRequest hook). Lightpanda's
+		// own inner requests self-identify via UA and fall through to the SPA shell.
+		if (prerender) {
+			const ssrRes = await prerender.handle(req)
+			if (ssrRes) return ssrRes
+		}
+
+		const url = new URL(req.url)
+		if (!isDev) {
+			const staticFile = await serveDistFile(url.pathname)
+			if (staticFile) return staticFile
+		}
+		if (url.pathname.startsWith('/api')) {
+			return handleApi(req)
+		}
+		// SPA fallback: serve the shell for any non-static, non-API path so the
+		// client router owns routing. New client routes need no server change.
+		// Unknown /api/* paths still 404 (handled by handleApi above).
+		return new Response(Bun.file('dist/index.html'))
+	},
+})
+
+console.log(`mino-starter on http://localhost:${server.port}`)
diff --git a/backend/ssr/prerender.ts b/backend/ssr/prerender.ts
new file mode 100644
index 0000000..d59f83c
--- /dev/null
+++ b/backend/ssr/prerender.ts
@@ -0,0 +1,128 @@
+import Crypto from 'node:crypto'
+import Fs from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { requestFromBrowser } from '@backend/ssr/request-from-browser'
+import { isbot } from 'isbot'
+
+export type PrerenderOptions = {
+	urls: (string | RegExp)[]
+	host?: string
+	port: number
+	cacheDir?: string
+}
+
+const CACHE_TTL_MINUTES = 5
+
+// Minimal pathname-key sanitizer (inlined to avoid an extra dependency).
+function sanitizePathname(pathname: string): string {
+	const stripped = pathname.replace(/\//g, '_').replace(/[^a-zA-Z0-9._-]/g, '')
+	return stripped || 'index'
+}
+
+function isRequestFromBot(userAgent: string): boolean {
+	const ua = userAgent
+	const lower = ua.toLowerCase()
+	return (
+		isbot(ua) ||
+		lower.startsWith('facebookexternalhit') ||
+		lower.startsWith('whatsapp') ||
+		lower.startsWith('twitterbot')
+	)
+}
+
+function matchesAllowlist(
+	requestUrl: string,
+	requestPathname: string,
+	urls: (string | RegExp)[],
+): boolean {
+	for (const url of urls) {
+		if (typeof url === 'string') {
+			if (url === requestPathname) return true
+		} else if (url.test(requestUrl)) {
+			return true
+		}
+	}
+	return false
+}
+
+export function createPrerenderHandler(opts: PrerenderOptions): {
+	handle: (req: Request) => Promise<Response | null>
+} {
+	const cacheDir =
+		opts.cacheDir ?? Fs.mkdtempSync(join(tmpdir(), 'mino-prerender-'))
+	Fs.mkdirSync(cacheDir, { recursive: true })
+
+	const origin = `http://${opts.host ?? 'localhost'}:${opts.port}`
+
+	// Returns a rendered Response, or null to let the request fall through.
+	async function handle(req: Request): Promise<Response | null> {
+		if (req.method !== 'GET') return null
+		const userAgent = req.headers.get('user-agent') ?? ''
+
+		// Lightpanda's own requests self-identify → break the recursion.
+		if (userAgent.startsWith('Lightpanda/')) return null
+		if (!isRequestFromBot(userAgent)) return null
+
+		const parsed = new URL(req.url)
+		const pathAndQuery = `${parsed.pathname}${parsed.search}`
+		// Match pathname for strings, path+query for regex (Bun's req.url is absolute).
+		if (!matchesAllowlist(pathAndQuery, parsed.pathname, opts.urls)) return null
+
+		const renderUrl = `${origin}${pathAndQuery}`
+		const cached = getCachedResponse(cacheDir, renderUrl)
+		if (cached) return cached
+
+		const html = (await requestFromBrowser(renderUrl).catch(() => '')) ?? ''
+		// Empty render (failure/timeout) → don't poison the cache; fall through to
+		// the raw SPA shell so the bot still gets valid HTML instead of a blank page.
+		if (!html) return null
+
+		setCachedResponse(cacheDir, renderUrl, html)
+
+		return new Response(html, {
+			headers: { 'content-type': 'text/html; charset=utf-8' },
+		})
+	}
+
+	return { handle }
+}
+
+function cacheKeyForUrl(url: string): { filename: string } {
+	const urlObj = new URL(url)
+	const pathname = sanitizePathname(urlObj.pathname)
+	const queryString = urlObj.search
+	let filename = pathname
+	if (queryString) {
+		const queryHash = Crypto.createHash('md5').update(queryString).digest('hex')
+		filename = `${filename}_${queryHash}`
+	}
+	filename = `${filename}.html`
+	return { filename }
+}
+
+function getCachedResponse(cacheDir: string, url: string): Response | null {
+	const { filename } = cacheKeyForUrl(url)
+	const filepath = join(cacheDir, filename)
+
+	if (!Fs.existsSync(filepath)) return null
+	const fileStat = Fs.statSync(filepath)
+	const fileAgeMinutes = (Date.now() - fileStat.mtime.getTime()) / 1_000 / 60
+	if (fileAgeMinutes <= CACHE_TTL_MINUTES) {
+		return new Response(Fs.readFileSync(filepath), {
+			headers: { 'content-type': 'text/html; charset=utf-8' },
+		})
+	}
+	Fs.rmSync(filepath)
+	return null
+}
+
+function setCachedResponse(cacheDir: string, url: string, html: string): void {
+	const { filename } = cacheKeyForUrl(url)
+	const filepath = join(cacheDir, filename)
+	try {
+		Fs.writeFileSync(filepath, html)
+	} catch {
+		// cache write failure is non-fatal
+	}
+}
diff --git a/backend/ssr/request-from-browser.ts b/backend/ssr/request-from-browser.ts
new file mode 100644
index 0000000..ffe286b
--- /dev/null
+++ b/backend/ssr/request-from-browser.ts
@@ -0,0 +1,61 @@
+import { execFileSync } from 'node:child_process'
+import { homedir } from 'node:os'
+import { resolve as resolvePath } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import {
+	isMainThread,
+	parentPort,
+	Worker,
+	workerData,
+} from 'node:worker_threads'
+
+// Resolve the lightpanda binary the same way @lightpanda/browser does:
+// LIGHTPANDA_EXECUTABLE_PATH wins, else ~/.cache/lightpanda-node/lightpanda.
+function lightpandaBinary(): string {
+	return (
+		process.env.LIGHTPANDA_EXECUTABLE_PATH ??
+		resolvePath(`${homedir()}/.cache/lightpanda-node/lightpanda`)
+	)
+}
+
+export async function requestFromBrowser(url: string): Promise<string> {
+	return new Promise<string>((resolve, reject) => {
+		const worker = new Worker(fileURLToPath(import.meta.url), {
+			workerData: { url },
+		})
+		worker.on('message', (m) => {
+			resolve(m as string)
+			worker.terminate().catch(() => {})
+		})
+		worker.on('error', (e) => {
+			reject(e)
+			worker.terminate().catch(() => {})
+		})
+	})
+}
+
+if (!isMainThread) {
+	// We spawn the lightpanda CLI directly instead of using @lightpanda/browser's
+	// JS `fetch` helper. The helper (1.3.2) only passes `--dump html` and does not
+	// expose `--wait-until`, so the binary uses its default `load` event — which
+	// fires before the SPA's async tRPC queries resolve, producing a render with
+	// "Loading…" instead of the real content. `networkidle` waits for in-flight
+	// XHR/fetch (the siteInfo query) to settle, so the dumped DOM contains the
+	// rendered tagline. The CLI's own User-Agent ("Lightpanda/...") is what the
+	// prerender handler matches to break the render-recursion loop.
+	void (async (): Promise<void> => {
+		const html = execFileSync(
+			lightpandaBinary(),
+			[
+				'fetch',
+				workerData.url as string,
+				'--dump',
+				'html',
+				'--wait-until',
+				'networkidle',
+			],
+			{ encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 },
+		)
+		parentPort?.postMessage(html)
+	})()
+}
diff --git a/backend/trpc/context.ts b/backend/trpc/context.ts
