new file mode 100755
index 0000000..f27683c
--- /dev/null
+++ b/scripts/e2e-reset-db.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Reset the E2E SQLite DB. Run from the Playwright `webServer.command` string,
+# BEFORE the test server starts.
+#
+# It must not live in `globalSetup`: Playwright starts the webServer first and
+# runs globalSetup afterwards (verified with DEBUG=pw:webserver), so a wipe in
+# globalSetup deletes `prisma/test.db` out from under a server that has already
+# opened it. The first query after that fails with
+# `SQLITE_IOERR_VNODE: disk I/O error` (the server opens the file at boot — e.g.
+# the scheduler restore in backend/boot.ts — not on first request).
+#
+# Fresh DB without `prisma migrate reset` (which Prisma's AI-agent guard blocks
+# when run under an agent). Deleting the SQLite file + `migrate deploy`
+# (idempotent, non-interactive, non-destructive) gives the same clean result.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+rm -f prisma/test.db prisma/test.db-journal
+DATABASE_URL=file:./test.db bunx prisma migrate deploy
diff --git a/scripts/premerge.sh b/scripts/premerge.sh
new file mode 100755
index 0000000..67f7b5d
--- /dev/null
+++ b/scripts/premerge.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# Local quick-merge: run the shared check gate, and if green, fast-forward
+# merge the current branch into main and push it. Returns you to your branch.
+#
+#   bun run premerge
+#
+# Requires a clean working tree and `origin/main` to not have diverged.
+set -euo pipefail
+
+branch=$(git branch --show-current)
+if [ -z "$branch" ]; then
+	echo "Could not detect current branch (detached HEAD?)." >&2
+	exit 1
+fi
+if [ "$branch" = "main" ]; then
+	echo "Already on main — nothing to merge." >&2
+	exit 1
+fi
+
+if [ -n "$(git status --porcelain)" ]; then
+	echo "Working tree not clean. Commit or stash first." >&2
+	git status --short
+	exit 1
+fi
+
+echo "Running pre-merge checks on '$branch'..."
+bash scripts/check.sh
+
+echo
+echo "Checks green. Merging '$branch' → main..."
+git checkout main
+# Pull only if main tracks a remote; otherwise proceed.
+if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
+	git pull --ff-only
+fi
+git merge --ff-only "$branch"
+if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
+	git push
+fi
+git checkout "$branch"
+echo
+printf '\033[32m✓ merged %s → main and pushed. Back on %s.\033[0m\n' "$branch" "$branch"
