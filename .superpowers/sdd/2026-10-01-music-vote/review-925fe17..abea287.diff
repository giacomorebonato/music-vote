+import { afterEach, beforeEach, expect, test } from 'bun:test'
+import { homedir } from 'node:os'
+import { resolve as resolvePath } from 'node:path'
+
+import { lightpandaBinary } from '@backend/ssr/request-from-browser'
+
+const DEFAULT_BINARY = resolvePath(
+	`${homedir()}/.cache/lightpanda-node/lightpanda`,
+)
+
+const original = process.env.LIGHTPANDA_EXECUTABLE_PATH
+
+beforeEach(() => {
+	delete process.env.LIGHTPANDA_EXECUTABLE_PATH
+})
+
+afterEach(() => {
+	if (original === undefined) delete process.env.LIGHTPANDA_EXECUTABLE_PATH
+	else process.env.LIGHTPANDA_EXECUTABLE_PATH = original
+})
+
+test('defaults to the postinstall-cached browser binary when unset', () => {
+	expect(lightpandaBinary()).toBe(DEFAULT_BINARY)
+})
+
+test('an empty LIGHTPANDA_EXECUTABLE_PATH falls back to the default', () => {
+	process.env.LIGHTPANDA_EXECUTABLE_PATH = ''
+	expect(lightpandaBinary()).toBe(DEFAULT_BINARY)
+})
+
+test('a whitespace-only LIGHTPANDA_EXECUTABLE_PATH falls back to the default', () => {
+	process.env.LIGHTPANDA_EXECUTABLE_PATH = '   '
+	expect(lightpandaBinary()).toBe(DEFAULT_BINARY)
+})
+
+test('an explicit LIGHTPANDA_EXECUTABLE_PATH wins', () => {
+	process.env.LIGHTPANDA_EXECUTABLE_PATH = '/opt/lightpanda/lightpanda'
+	expect(lightpandaBinary()).toBe('/opt/lightpanda/lightpanda')
+})
diff --git a/backend/ssr/prerender.ts b/backend/ssr/prerender.ts
new file mode 100644
index 0000000..d59f83c
--- /dev/null
+++ b/backend/ssr/prerender.ts
@@ -0,0 +1,128 @@
+import Crypto from 'node:crypto'
+import Fs from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { requestFromBrowser } from '@backend/ssr/request-from-browser'
+import { isbot } from 'isbot'
+
+export type PrerenderOptions = {
+	urls: (string | RegExp)[]
+	host?: string
+	port: number
+	cacheDir?: string
+}
+
+const CACHE_TTL_MINUTES = 5
+
+// Minimal pathname-key sanitizer (inlined to avoid an extra dependency).
+function sanitizePathname(pathname: string): string {
+	const stripped = pathname.replace(/\//g, '_').replace(/[^a-zA-Z0-9._-]/g, '')
+	return stripped || 'index'
+}
+
+function isRequestFromBot(userAgent: string): boolean {
+	const ua = userAgent
+	const lower = ua.toLowerCase()
+	return (
+		isbot(ua) ||
+		lower.startsWith('facebookexternalhit') ||
+		lower.startsWith('whatsapp') ||
+		lower.startsWith('twitterbot')
+	)
+}
+
+function matchesAllowlist(
+	requestUrl: string,
+	requestPathname: string,
+	urls: (string | RegExp)[],
+): boolean {
+	for (const url of urls) {
+		if (typeof url === 'string') {
+			if (url === requestPathname) return true
+		} else if (url.test(requestUrl)) {
+			return true
+		}
+	}
+	return false
+}
+
+export function createPrerenderHandler(opts: PrerenderOptions): {
+	handle: (req: Request) => Promise<Response | null>
+} {
+	const cacheDir =
+		opts.cacheDir ?? Fs.mkdtempSync(join(tmpdir(), 'mino-prerender-'))
+	Fs.mkdirSync(cacheDir, { recursive: true })
+
+	const origin = `http://${opts.host ?? 'localhost'}:${opts.port}`
+
+	// Returns a rendered Response, or null to let the request fall through.
+	async function handle(req: Request): Promise<Response | null> {
+		if (req.method !== 'GET') return null
+		const userAgent = req.headers.get('user-agent') ?? ''
+
+		// Lightpanda's own requests self-identify → break the recursion.
+		if (userAgent.startsWith('Lightpanda/')) return null
+		if (!isRequestFromBot(userAgent)) return null
+
+		const parsed = new URL(req.url)
+		const pathAndQuery = `${parsed.pathname}${parsed.search}`
+		// Match pathname for strings, path+query for regex (Bun's req.url is absolute).
+		if (!matchesAllowlist(pathAndQuery, parsed.pathname, opts.urls)) return null
+
+		const renderUrl = `${origin}${pathAndQuery}`
+		const cached = getCachedResponse(cacheDir, renderUrl)
+		if (cached) return cached
+
+		const html = (await requestFromBrowser(renderUrl).catch(() => '')) ?? ''
+		// Empty render (failure/timeout) → don't poison the cache; fall through to
+		// the raw SPA shell so the bot still gets valid HTML instead of a blank page.
+		if (!html) return null
+
+		setCachedResponse(cacheDir, renderUrl, html)
+
+		return new Response(html, {
+			headers: { 'content-type': 'text/html; charset=utf-8' },
+		})
+	}
+
+	return { handle }
+}
+
+function cacheKeyForUrl(url: string): { filename: string } {
+	const urlObj = new URL(url)
+	const pathname = sanitizePathname(urlObj.pathname)
+	const queryString = urlObj.search
+	let filename = pathname
+	if (queryString) {
+		const queryHash = Crypto.createHash('md5').update(queryString).digest('hex')
+		filename = `${filename}_${queryHash}`
+	}
+	filename = `${filename}.html`
+	return { filename }
+}
+
+function getCachedResponse(cacheDir: string, url: string): Response | null {
+	const { filename } = cacheKeyForUrl(url)
+	const filepath = join(cacheDir, filename)
+
+	if (!Fs.existsSync(filepath)) return null
+	const fileStat = Fs.statSync(filepath)
+	const fileAgeMinutes = (Date.now() - fileStat.mtime.getTime()) / 1_000 / 60
+	if (fileAgeMinutes <= CACHE_TTL_MINUTES) {
+		return new Response(Fs.readFileSync(filepath), {
+			headers: { 'content-type': 'text/html; charset=utf-8' },
+		})
+	}
+	Fs.rmSync(filepath)
+	return null
+}
+
+function setCachedResponse(cacheDir: string, url: string, html: string): void {
+	const { filename } = cacheKeyForUrl(url)
+	const filepath = join(cacheDir, filename)
+	try {
+		Fs.writeFileSync(filepath, html)
+	} catch {
+		// cache write failure is non-fatal
+	}
+}
diff --git a/backend/ssr/request-from-browser.ts b/backend/ssr/request-from-browser.ts
new file mode 100644
index 0000000..46cb493
--- /dev/null
+++ b/backend/ssr/request-from-browser.ts
@@ -0,0 +1,63 @@
+import { execFileSync } from 'node:child_process'
+import { homedir } from 'node:os'
+import { resolve as resolvePath } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import {
+	isMainThread,
+	parentPort,
+	Worker,
+	workerData,
+} from 'node:worker_threads'
+
+// Resolve the lightpanda binary the same way @lightpanda/browser does:
+// LIGHTPANDA_EXECUTABLE_PATH wins, else ~/.cache/lightpanda-node/lightpanda.
+// An empty or whitespace-only value is treated as unset — otherwise
+// execFileSync('') throws and prerender silently serves the raw SPA shell.
+export function lightpandaBinary(): string {
+	return (
+		process.env.LIGHTPANDA_EXECUTABLE_PATH?.trim() ||
+		resolvePath(`${homedir()}/.cache/lightpanda-node/lightpanda`)
+	)
+}
+
+export async function requestFromBrowser(url: string): Promise<string> {
+	return new Promise<string>((resolve, reject) => {
+		const worker = new Worker(fileURLToPath(import.meta.url), {
+			workerData: { url },
+		})
+		worker.on('message', (m) => {
+			resolve(m as string)
+			worker.terminate().catch(() => {})
+		})
+		worker.on('error', (e) => {
+			reject(e)
+			worker.terminate().catch(() => {})
+		})
+	})
+}
+
+if (!isMainThread) {
+	// We spawn the lightpanda CLI directly instead of using @lightpanda/browser's
+	// JS `fetch` helper. The helper (1.3.2) only passes `--dump html` and does not
+	// expose `--wait-until`, so the binary uses its default `load` event — which
+	// fires before the SPA's async tRPC queries resolve, producing a render with
+	// "Loading…" instead of the real content. `networkidle` waits for in-flight
+	// XHR/fetch (the siteInfo query) to settle, so the dumped DOM contains the
+	// rendered tagline. The CLI's own User-Agent ("Lightpanda/...") is what the
+	// prerender handler matches to break the render-recursion loop.
+	void (async (): Promise<void> => {
+		const html = execFileSync(
+			lightpandaBinary(),
+			[
+				'fetch',
+				workerData.url as string,
+				'--dump',
+				'html',
+				'--wait-until',
+				'networkidle',
+			],
+			{ encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 },
+		)
+		parentPort?.postMessage(html)
+	})()
+}
