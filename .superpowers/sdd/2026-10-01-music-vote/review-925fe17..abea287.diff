diff --git a/frontend/lib/__tests__/apply-status.test.ts b/frontend/lib/__tests__/apply-status.test.ts
new file mode 100644
index 0000000..dbf2e1c
--- /dev/null
+++ b/frontend/lib/__tests__/apply-status.test.ts
@@ -0,0 +1,87 @@
+import { expect, test } from 'bun:test'
+import {
+	type ApplyStatusState,
+	initialApplyStatusState,
+	reduceApplyStatus,
+} from '@frontend/lib/apply-status'
+
+/**
+ * The badge has two asynchronous writers (the `code_update` frame handler and
+ * the undo mutation). These tests fix the invariant the host console needs:
+ * once the host undoes a change, the badge reads `reverted` whichever writer
+ * completes first.
+ */
+
+const APPLIED = { text: 'change applied', tone: 'success' } as const
+const REVERTED = { text: 'reverted', tone: 'warning' } as const
+
+test('undo response first: a late apply result for the superseded version is ignored', () => {
+	const start: ApplyStatusState = reduceApplyStatus(initialApplyStatusState, {
+		type: 'start',
+		seq: 1,
+	})
+	// Undo is clicked while the apply above is still running in Strudel.
+	const undoStarted: ApplyStatusState = reduceApplyStatus(start, {
+		type: 'start',
+		seq: 2,
+	})
+	const undone: ApplyStatusState = reduceApplyStatus(undoStarted, {
+		type: 'reverted',
+		seq: 2,
+	})
+	expect(undone.status).toEqual(REVERTED)
+
+	// The earlier apply's `evaluate` resolves only now.
+	const late: ApplyStatusState = reduceApplyStatus(undone, {
+		type: 'applied',
+		seq: 1,
+	})
+	expect(late.status).toEqual(REVERTED)
+})
+
+test('WS apply first: the undo response still wins and stays reverted', () => {
+	let state: ApplyStatusState = reduceApplyStatus(initialApplyStatusState, {
+		type: 'start',
+		seq: 1,
+	})
+	state = reduceApplyStatus(state, { type: 'applied', seq: 1 })
+	expect(state.status).toEqual(APPLIED)
+
+	state = reduceApplyStatus(state, { type: 'start', seq: 2 })
+	state = reduceApplyStatus(state, { type: 'reverted', seq: 2 })
+	expect(state.status).toEqual(REVERTED)
+
+	// The undo's own `code_update` frame lands after the mutation response and
+	// reuses the undo's token: same outcome, so it cannot flip the badge.
+	state = reduceApplyStatus(state, { type: 'reverted', seq: 2 })
+	expect(state.status).toEqual(REVERTED)
+})
+
+test('a later apply after an undo still updates the badge', () => {
+	let state: ApplyStatusState = reduceApplyStatus(initialApplyStatusState, {
+		type: 'start',
+		seq: 1,
+	})
+	state = reduceApplyStatus(state, { type: 'reverted', seq: 1 })
+	expect(state.status).toEqual(REVERTED)
+
+	// Next poll's evolution, or the outro.
+	state = reduceApplyStatus(state, { type: 'start', seq: 2 })
+	state = reduceApplyStatus(state, { type: 'applied', seq: 2 })
+	expect(state.status).toEqual(APPLIED)
+})
+
+test('a rejected apply reports the error and outranks an older apply', () => {
+	let state: ApplyStatusState = reduceApplyStatus(initialApplyStatusState, {
+		type: 'start',
+		seq: 1,
+	})
+	state = reduceApplyStatus(state, { type: 'applied', seq: 1 })
+	state = reduceApplyStatus(state, { type: 'start', seq: 2 })
+	state = reduceApplyStatus(state, { type: 'failed', seq: 2, error: 'boom' })
+	expect(state.status).toEqual({ text: 'change rejected: boom', tone: 'error' })
+
+	// A late success from the superseded apply cannot clear the error.
+	state = reduceApplyStatus(state, { type: 'applied', seq: 1 })
+	expect(state.status).toEqual({ text: 'change rejected: boom', tone: 'error' })
+})
diff --git a/frontend/lib/__tests__/room-ws.test.ts b/frontend/lib/__tests__/room-ws.test.ts
new file mode 100644
index 0000000..7c4a7d2
--- /dev/null
+++ b/frontend/lib/__tests__/room-ws.test.ts
@@ -0,0 +1,160 @@
+import { expect, test } from 'bun:test'
+import { createRoomChannel } from '@frontend/lib/room-ws'
+import type { WsEvent } from '@shared/realtime/events'
+
+class FakeSocket {
+	static instances: FakeSocket[] = []
+
+	readonly url: string
+	readyState = 1
+	onopen: (() => void) | null = null
+	onmessage: ((event: MessageEvent) => void) | null = null
+	onclose: (() => void) | null = null
+	onerror: (() => void) | null = null
+
+	constructor(url: string) {
+		this.url = url
+		FakeSocket.instances.push(this)
+	}
+
+	close(): void {
+		this.readyState = 3
+	}
+
+	emitOpen(): void {
+		this.onopen?.()
+	}
+
+	emitMessage(data: string): void {
+		this.onmessage?.({ data } as MessageEvent)
+	}
+
+	emitDrop(): void {
+		this.readyState = 3
+		this.onclose?.()
+	}
+}
+
+type Scheduled = { callback: () => void; delayMs: number; cancelled: boolean }
+
+function makeHarness() {
+	FakeSocket.instances = []
+	const scheduled: Scheduled[] = []
+	const events: WsEvent[] = []
+	let reconnects = 0
+	let connected: boolean | null = null
+
+	const channel = createRoomChannel({
+		roomId: 'room-1',
+		url: 'ws://test.invalid/ws?room=room-1',
+		wsFactory: (url) => new FakeSocket(url),
+		scheduler: {
+			schedule: (callback, delayMs) => {
+				const entry: Scheduled = { callback, delayMs, cancelled: false }
+				scheduled.push(entry)
+				return entry
+			},
+			cancel: (handle) => {
+				;(handle as Scheduled).cancelled = true
+			},
+		},
+		onEvent: (event) => events.push(event),
+		onReconnect: () => {
+			reconnects += 1
+		},
+		onStatusChange: (isConnected) => {
+			connected = isConnected
+		},
+	})
+
+	return {
+		channel,
+		scheduled,
+		events,
+		get reconnects() {
+			return reconnects
+		},
+		get connected() {
+			return connected
+		},
+	}
+}
+
+test('dispatches parsed events to onEvent', () => {
+	const harness = makeHarness()
+	const socket = FakeSocket.instances[0]
+	expect(socket?.url).toBe('ws://test.invalid/ws?room=room-1')
+
+	socket?.emitOpen()
+	expect(harness.connected).toBe(true)
+
+	socket?.emitMessage(JSON.stringify({ type: 'warning', message: 'llm down' }))
+	expect(harness.events).toEqual([{ type: 'warning', message: 'llm down' }])
+
+	socket?.emitMessage('not json')
+	expect(harness.events).toHaveLength(1)
+
+	harness.channel.close()
+})
+
+test('reconnects after close and signals resync on reconnect', () => {
+	const harness = makeHarness()
+	const first = FakeSocket.instances[0]
+	first?.emitOpen()
+	expect(harness.reconnects).toBe(0)
+
+	first?.emitDrop()
+	expect(harness.connected).toBe(false)
+	expect(harness.scheduled[0]?.delayMs).toBe(1000)
+
+	harness.scheduled[0]?.callback()
+	const second = FakeSocket.instances[1]
+	expect(second).toBeDefined()
+	second?.emitOpen()
+	expect(harness.reconnects).toBe(1)
+	expect(harness.connected).toBe(true)
+
+	harness.channel.close()
+})
+
+test('backoff doubles after each failed attempt (no successful open)', () => {
+	const harness = makeHarness()
+
+	FakeSocket.instances[0]?.emitDrop()
+	harness.scheduled[0]?.callback()
+	FakeSocket.instances[1]?.emitDrop()
+	harness.scheduled[1]?.callback()
+	FakeSocket.instances[2]?.emitDrop()
+
+	expect(harness.scheduled.map((entry) => entry.delayMs)).toEqual([
+		1000, 2000, 4000,
+	])
+
+	harness.channel.close()
+})
+
+test('backoff is capped at 10s', () => {
+	const harness = makeHarness()
+	for (let i = 0; i < 6; i++) {
+		FakeSocket.instances.at(-1)?.emitDrop()
+		harness.scheduled.at(-1)?.callback()
+	}
+	const delays = harness.scheduled.map((entry) => entry.delayMs)
+	expect(delays).toEqual([1000, 2000, 4000, 8000, 10_000, 10_000])
+	harness.channel.close()
+})
+
+test('close cancels the pending reconnect and closes the socket', () => {
+	const harness = makeHarness()
+	const socket = FakeSocket.instances[0]
+	socket?.emitOpen()
+	socket?.emitDrop()
+	expect(harness.scheduled).toHaveLength(1)
+
+	harness.channel.close()
+	expect(harness.scheduled[0]?.cancelled).toBe(true)
+	expect(socket?.readyState).toBe(3)
+
+	harness.scheduled[0]?.callback()
+	expect(FakeSocket.instances).toHaveLength(1)
+})
diff --git a/frontend/lib/apply-status.ts b/frontend/lib/apply-status.ts
new file mode 100644
index 0000000..bf811c3
--- /dev/null
+++ b/frontend/lib/apply-status.ts
@@ -0,0 +1,68 @@
+export type ApplyStatus = {
+	text: string
+	tone: 'success' | 'error' | 'warning'
+}
+
+/**
+ * Host-console "apply status" badge state.
+ *
+ * The badge has two writers — the `code_update` frame handler and the undo
+ * mutation — and their completions are asynchronous, so which one lands last is
+ * not fixed: a Strudel `evaluate` from an earlier apply can resolve *after* the
+ * undo response, and the undo's own frame can arrive before or after it. Pure
+ * last-writer-wins would then show `change applied` for a set the host just
+ * reverted.
+ *
+ * The badge is therefore the outcome of the newest operation. Every operation
+ * claims a monotonic `seq` when it STARTS (an apply frame, or the Undo click),
+ * and a fact is applied only while no newer operation has been claimed. The
+ * claimed `seq` lives in the state, so the claim alone rejects the older
+ * operation's in-flight result — no dependence on render timing.
+ */
+export type ApplyStatusState = {
+	status: ApplyStatus | null
+	seq: number
+}
+
+export const initialApplyStatusState: ApplyStatusState = {
+	status: null,
+	seq: 0,
+}
+
+export type ApplyStatusFact =
+	/** An operation claimed `seq`. Leaves the badge alone, invalidates older writes. */
+	| { type: 'start'; seq: number }
+	/** An apply finished and the audio engine accepted the code. */
+	| { type: 'applied'; seq: number }
+	/** The host reverted the last change (undo response or the undo frame). */
+	| { type: 'reverted'; seq: number }
+	/** An apply (or the host's report of it) was rejected. */
+	| { type: 'failed'; seq: number; error: string }
+
+export function reduceApplyStatus(
+	state: ApplyStatusState,
+	fact: ApplyStatusFact,
+): ApplyStatusState {
+	if (fact.type === 'start') {
+		return { status: state.status, seq: Math.max(state.seq, fact.seq) }
+	}
+	if (fact.seq < state.seq) return state
+
+	switch (fact.type) {
+		case 'applied':
+			return {
+				status: { text: 'change applied', tone: 'success' },
+				seq: state.seq,
+			}
+		case 'reverted':
+			return {
+				status: { text: 'reverted', tone: 'warning' },
+				seq: state.seq,
+			}
+		case 'failed':
+			return {
+				status: { text: `change rejected: ${fact.error}`, tone: 'error' },
+				seq: state.seq,
+			}
+	}
+}
