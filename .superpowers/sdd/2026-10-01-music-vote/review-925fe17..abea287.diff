+
+// --- generateOutro ---
+
+test('generateOutro: happy path returns validated code', async () => {
+	const provider = new MockLlmProvider([validCode])
+	const doc = initialStateDoc(params)
+	const outro = await generateOutro(provider, doc, validCode)
