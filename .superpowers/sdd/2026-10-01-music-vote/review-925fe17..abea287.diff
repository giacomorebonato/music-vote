diff --git a/backend/__tests__/boot.test.ts b/backend/__tests__/boot.test.ts
new file mode 100644
index 0000000..4d02dd8
--- /dev/null
+++ b/backend/__tests__/boot.test.ts
@@ -0,0 +1,51 @@
+import { expect, spyOn, test } from 'bun:test'
+import { readFileSync } from 'node:fs'
+
+import { bootSchedulers } from '@backend/boot'
+
+test('bootSchedulers awaits the injected restore exactly once', async () => {
+	let calls = 0
+	await bootSchedulers(async () => {
+		calls += 1
+	})
+	expect(calls).toBe(1)
+})
+
+test('a failing restore is logged, not thrown (server still boots)', async () => {
+	const logged = spyOn(console, 'error').mockImplementation(() => {})
+	const failure = new Error('db unavailable')
+
+	try {
+		await expect(
+			bootSchedulers(async () => {
+				throw failure
+			}),
+		).resolves.toBeUndefined()
+		expect(logged).toHaveBeenCalledTimes(1)
+		expect(logged.mock.calls[0]?.[1]).toBe(failure)
+	} finally {
+		logged.mockRestore()
+	}
+})
+
+/**
+ * Wiring guard — not a behavior test.
+ *
+ * `restoreSchedulers` existed, was unit-tested, and was never called from the
+ * production entrypoint, so the spec's failure-table promise ("server restart
+ * rebuilds timers from DB", docs/agents/music-vote.md) was silently broken:
+ * after a mid-set restart, live rooms were orphaned. A unit test on
+ * `bootSchedulers` cannot catch that — it passes whether or not anything calls
+ * the seam. This asserts the file `bun run dev` / `bun run start` actually
+ * execute (`backend/server.ts`) imports and awaits it.
+ */
+test('server.ts wires the boot restore seam (wiring guard)', () => {
+	const source = readFileSync(new URL('../server.ts', import.meta.url), 'utf8')
+	const withoutImports = source
+		.split('\n')
+		.filter((line) => !line.trimStart().startsWith('import'))
+		.join('\n')
+
+	expect(source).toMatch(/from '@backend\/boot'/)
+	expect(withoutImports).toMatch(/await bootSchedulers\(\)/)
+})
diff --git a/backend/__tests__/normalize-trpc-request.test.ts b/backend/__tests__/normalize-trpc-request.test.ts
new file mode 100644
index 0000000..182a284
--- /dev/null
+++ b/backend/__tests__/normalize-trpc-request.test.ts
@@ -0,0 +1,53 @@
+import { expect, test } from 'bun:test'
+import {
+	normalizeTrpcRequest,
+	TRPC_ENDPOINT,
+} from '@backend/normalize-trpc-request'
+
+function call(
+	pathnameAndSearch: string,
+	init?: RequestInit,
+): { req: Request; result: Request } {
+	const req = new Request(`http://localhost${pathnameAndSearch}`, init)
+	const url = new URL(req.url)
+	return { req, result: normalizeTrpcRequest(req, url) }
+}
+
+test('passes the bare endpoint through unchanged', () => {
+	const { req, result } = call(TRPC_ENDPOINT)
+	expect(result).toBe(req)
+})
+
+test('passes the bare endpoint with a query through unchanged', () => {
+	const { req, result } = call(`${TRPC_ENDPOINT}?batch=1`)
+	expect(result).toBe(req)
+})
+
+test('normalizes a slash-separated procedure path to dots', () => {
+	const { result } = call('/api/trpc/notes/list')
+	expect(new URL(result.url).pathname).toBe('/api/trpc/notes.list')
+})
+
+test('is idempotent on already dot-separated paths', () => {
+	const { result } = call('/api/trpc/notes.list')
+	expect(new URL(result.url).pathname).toBe('/api/trpc/notes.list')
+})
+
+test('preserves the query string', () => {
+	const { result } = call('/api/trpc/notes/list?batch=1&input=%7B%7D')
+	expect(new URL(result.url).search).toBe('?batch=1&input=%7B%7D')
