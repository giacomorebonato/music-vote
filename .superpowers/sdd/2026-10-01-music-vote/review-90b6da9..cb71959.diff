diff --git a/frontend/components/__tests__/poll-monitor.test.tsx b/frontend/components/__tests__/poll-monitor.test.tsx
new file mode 100644
index 0000000..f7157f1
--- /dev/null
+++ b/frontend/components/__tests__/poll-monitor.test.tsx
@@ -0,0 +1,37 @@
+import { expect, test } from 'bun:test'
+import { PollMonitor } from '@frontend/components/poll-monitor'
+import { renderToStaticMarkup } from 'react-dom/server'
+
+test('renders bars from the poll option keys with no yes/no hardcoding', () => {
+	const markup = renderToStaticMarkup(
+		<PollMonitor
+			question="End the set?"
+			options={[
+				{ key: 'wrap', label: 'Wrap it up' },
+				{ key: 'continue', label: 'Keep going' },
+			]}
+			counts={{ wrap: 3, continue: 1 }}
+		/>,
+	)
+
+	expect(markup).toContain('End the set?')
+	expect(markup).toContain('Wrap it up')
+	expect(markup).toContain('Keep going')
+	expect(markup).toContain('data-testid="poll-option-wrap"')
+	expect(markup).toContain('data-testid="poll-option-continue"')
+	expect(markup).toContain('>3<')
+	expect(markup).toContain('>1<')
+	expect(markup).not.toContain('Yes')
+	expect(markup).not.toContain('No')
+})
+
+test('renders a missing count as zero', () => {
+	const markup = renderToStaticMarkup(
+		<PollMonitor
+			question="Continue?"
+			options={[{ key: 'yes', label: 'Yes' }]}
+			counts={{}}
+		/>,
+	)
+	expect(markup).toContain('>0<')
+})
diff --git a/frontend/components/__tests__/qr-code.test.tsx b/frontend/components/__tests__/qr-code.test.tsx
new file mode 100644
index 0000000..43a23a5
--- /dev/null
+++ b/frontend/components/__tests__/qr-code.test.tsx
@@ -0,0 +1,19 @@
+import { expect, test } from 'bun:test'
+import { QrCode, qrDataUrl } from '@frontend/components/qr-code'
+import { renderToStaticMarkup } from 'react-dom/server'
+
+const VOTE_URL = 'http://localhost:3000/r/room-123'
+
+test('qrDataUrl encodes a vote URL as a PNG data URL', async () => {
+	const dataUrl = await qrDataUrl(VOTE_URL)
+	expect(dataUrl.startsWith('data:image/png;base64,')).toBe(true)
+})
+
+test('QrCode renders an img whose src is the PNG data URL', async () => {
+	// The component reads its memoized data URL synchronously on the first
+	// render; priming here exercises the same cache path a mounted page uses.
+	await qrDataUrl(VOTE_URL)
+	const markup = renderToStaticMarkup(<QrCode value={VOTE_URL} />)
+	expect(markup).toContain('<img')
+	expect(markup).toContain('src="data:image/png')
+})
diff --git a/frontend/components/__tests__/strudel-player-import.test.ts b/frontend/components/__tests__/strudel-player-import.test.ts
new file mode 100644
index 0000000..58f3ea1
--- /dev/null
+++ b/frontend/components/__tests__/strudel-player-import.test.ts
@@ -0,0 +1,33 @@
+import { expect, mock, test } from 'bun:test'
+
+/**
+ * Import guard for the StrudelPlayer component under Bun's test runner.
+ *
+ * Without a `@strudel/web` mock, importing the component walks into the
+ * package's CJS `main` entry, which Bun's Node runtime cannot load (the
+ * browser bundler picks the ESM `module` entry instead). `mock.module` must
+ * be registered before the dynamic import so the seam module never resolves
+ * the real package.
+ *
+ * The ref contract itself (applyPattern/stop exposure, null-code guard,
+ * re-render stability, unmount hush) needs a DOM renderer this repo does not
+ * have; it is verified manually in the host console. See
+ * `.superpowers/sdd/2026-10-01-music-vote/task-12-report.md`.
+ */
+mock.module('@strudel/web', () => ({
+	initStrudel: mock(() => Promise.resolve()),
+	hush: mock(() => undefined),
+	evaluate: mock(() => Promise.resolve({ __pattern: true })),
+	samples: mock(() => Promise.resolve()),
+	loadBuffer: mock(() => Promise.resolve()),
+	getAudioContext: mock(() => null),
+	getSound: mock(() => null),
+	getSampleInfo: mock(() => ({ url: 'x', label: 'x' })),
+}))
+
+const playerModule = await import('@frontend/audio/strudel-player')
+
+test('StrudelPlayer module imports with @strudel/web mocked', () => {
+	expect(playerModule.StrudelPlayer).toBeDefined()
+	expect(playerModule.StrudelPlayer.displayName).toBe('StrudelPlayer')
+})
