+++ b/frontend/components/qr-code.tsx
@@ -0,0 +1,85 @@
+import { toDataURL } from 'qrcode'
+import { useEffect, useState } from 'react'
+
+const resolved = new Map<string, string>()
+const pending = new Map<string, Promise<string>>()
+
+/**
+ * Encode `value` as a PNG data URL. Results are memoized per value so a host
+ * page that refetches room state does not re-render the QR image each time.
+ */
+export function qrDataUrl(value: string): Promise<string> {
+	const cached = resolved.get(value)
+	if (cached) return Promise.resolve(cached)
+
+	const inFlight = pending.get(value)
+	if (inFlight) return inFlight
+
+	const promise = toDataURL(value, {
+		errorCorrectionLevel: 'M',
+		margin: 1,
+		width: 240,
+	}).then((dataUrl) => {
+		resolved.set(value, dataUrl)
+		pending.delete(value)
+		return dataUrl
+	})
+
+	pending.set(value, promise)
+	return promise
+}
+
+export function QrCode({
+	value,
+	size = 240,
+	className,
+}: {
+	value: string
+	size?: number
+	className?: string
+}) {
+	const [dataUrl, setDataUrl] = useState<string | null>(
+		() => resolved.get(value) ?? null,
+	)
+
+	useEffect(() => {
+		const cached = resolved.get(value)
+		if (cached) {
+			setDataUrl(cached)
+			return
+		}
+		let cancelled = false
+		void qrDataUrl(value).then(
+			(next) => {
+				if (!cancelled) setDataUrl(next)
+			},
+			() => {
+				if (!cancelled) setDataUrl(null)
+			},
+		)
+		return () => {
+			cancelled = true
+		}
+	}, [value])
+
+	if (!dataUrl) {
+		return (
+			<div
+				className="skeleton rounded-box"
+				style={{ width: size, height: size }}
+				aria-hidden="true"
+			/>
+		)
+	}
+
+	return (
+		<img
+			src={dataUrl}
+			alt={`QR code for ${value}`}
+			width={size}
+			height={size}
+			className={className}
+			data-testid="qr-code"
+		/>
+	)
+}
diff --git a/frontend/lib/__tests__/room-ws.test.ts b/frontend/lib/__tests__/room-ws.test.ts
new file mode 100644
index 0000000..7c4a7d2
--- /dev/null
+++ b/frontend/lib/__tests__/room-ws.test.ts
@@ -0,0 +1,160 @@
+import { expect, test } from 'bun:test'
+import { createRoomChannel } from '@frontend/lib/room-ws'
+import type { WsEvent } from '@shared/realtime/events'
+
+class FakeSocket {
+	static instances: FakeSocket[] = []
+
+	readonly url: string
+	readyState = 1
+	onopen: (() => void) | null = null
+	onmessage: ((event: MessageEvent) => void) | null = null
+	onclose: (() => void) | null = null
+	onerror: (() => void) | null = null
+
+	constructor(url: string) {
+		this.url = url
+		FakeSocket.instances.push(this)
+	}
+
+	close(): void {
+		this.readyState = 3
+	}
+
+	emitOpen(): void {
+		this.onopen?.()
+	}
+
+	emitMessage(data: string): void {
+		this.onmessage?.({ data } as MessageEvent)
+	}
+
+	emitDrop(): void {
+		this.readyState = 3
+		this.onclose?.()
+	}
+}
+
+type Scheduled = { callback: () => void; delayMs: number; cancelled: boolean }
+
+function makeHarness() {
+	FakeSocket.instances = []
+	const scheduled: Scheduled[] = []
+	const events: WsEvent[] = []
+	let reconnects = 0
+	let connected: boolean | null = null
+
+	const channel = createRoomChannel({
+		roomId: 'room-1',
+		url: 'ws://test.invalid/ws?room=room-1',
+		wsFactory: (url) => new FakeSocket(url),
+		scheduler: {
+			schedule: (callback, delayMs) => {
+				const entry: Scheduled = { callback, delayMs, cancelled: false }
+				scheduled.push(entry)
+				return entry
+			},
+			cancel: (handle) => {
+				;(handle as Scheduled).cancelled = true
+			},
+		},
+		onEvent: (event) => events.push(event),
+		onReconnect: () => {
+			reconnects += 1
+		},
+		onStatusChange: (isConnected) => {
+			connected = isConnected
+		},
+	})
+
+	return {
+		channel,
+		scheduled,
+		events,
+		get reconnects() {
+			return reconnects
+		},
+		get connected() {
+			return connected
+		},
+	}
+}
+
+test('dispatches parsed events to onEvent', () => {
+	const harness = makeHarness()
+	const socket = FakeSocket.instances[0]
+	expect(socket?.url).toBe('ws://test.invalid/ws?room=room-1')
+
+	socket?.emitOpen()
+	expect(harness.connected).toBe(true)
+
+	socket?.emitMessage(JSON.stringify({ type: 'warning', message: 'llm down' }))
+	expect(harness.events).toEqual([{ type: 'warning', message: 'llm down' }])
+
+	socket?.emitMessage('not json')
+	expect(harness.events).toHaveLength(1)
+
+	harness.channel.close()
+})
+
+test('reconnects after close and signals resync on reconnect', () => {
+	const harness = makeHarness()
+	const first = FakeSocket.instances[0]
+	first?.emitOpen()
+	expect(harness.reconnects).toBe(0)
+
+	first?.emitDrop()
+	expect(harness.connected).toBe(false)
+	expect(harness.scheduled[0]?.delayMs).toBe(1000)
+
+	harness.scheduled[0]?.callback()
+	const second = FakeSocket.instances[1]
+	expect(second).toBeDefined()
+	second?.emitOpen()
+	expect(harness.reconnects).toBe(1)
+	expect(harness.connected).toBe(true)
+
+	harness.channel.close()
+})
+
+test('backoff doubles after each failed attempt (no successful open)', () => {
+	const harness = makeHarness()
+
+	FakeSocket.instances[0]?.emitDrop()
+	harness.scheduled[0]?.callback()
+	FakeSocket.instances[1]?.emitDrop()
+	harness.scheduled[1]?.callback()
+	FakeSocket.instances[2]?.emitDrop()
+
+	expect(harness.scheduled.map((entry) => entry.delayMs)).toEqual([
+		1000, 2000, 4000,
+	])
+
+	harness.channel.close()
+})
+
+test('backoff is capped at 10s', () => {
+	const harness = makeHarness()
+	for (let i = 0; i < 6; i++) {
+		FakeSocket.instances.at(-1)?.emitDrop()
+		harness.scheduled.at(-1)?.callback()
+	}
+	const delays = harness.scheduled.map((entry) => entry.delayMs)
+	expect(delays).toEqual([1000, 2000, 4000, 8000, 10_000, 10_000])
+	harness.channel.close()
+})
+
+test('close cancels the pending reconnect and closes the socket', () => {
+	const harness = makeHarness()
+	const socket = FakeSocket.instances[0]
+	socket?.emitOpen()
+	socket?.emitDrop()
+	expect(harness.scheduled).toHaveLength(1)
+
+	harness.channel.close()
+	expect(harness.scheduled[0]?.cancelled).toBe(true)
+	expect(socket?.readyState).toBe(3)
+
+	harness.scheduled[0]?.callback()
+	expect(FakeSocket.instances).toHaveLength(1)
+})
diff --git a/frontend/lib/room-ws.ts b/frontend/lib/room-ws.ts
new file mode 100644
index 0000000..e5de0c5
--- /dev/null
+++ b/frontend/lib/room-ws.ts
@@ -0,0 +1,150 @@
+import type { WsEvent } from '@shared/realtime/events'
+import { useEffect, useRef, useState } from 'react'
+
+const INITIAL_BACKOFF_MS = 1000
+const MAX_BACKOFF_MS = 10_000
+
+/**
+ * Minimal structural WebSocket surface. The browser global and the injected
+ * test doubles both satisfy it, so the channel never opens a real socket in
+ * unit tests.
+ */
+type WebSocketLike = {
+	readyState: number
+	onopen: ((event: Event) => void) | null
+	onmessage: ((event: MessageEvent) => void) | null
+	onclose: ((event: CloseEvent) => void) | null
+	onerror: ((event: Event) => void) | null
+	close(): void
+}
+
+type WebSocketFactory = (url: string) => WebSocketLike
+
+type RoomScheduler = {
+	schedule(callback: () => void, delayMs: number): unknown
+	cancel(handle: unknown): void
+}
+
+export type RoomChannelOptions = {
+	roomId: string
+	onEvent: (event: WsEvent) => void
+	/** Fired on every successful open after a drop, so the caller can resync. */
+	onReconnect?: () => void
+	onStatusChange?: (connected: boolean) => void
+	url?: string
+	wsFactory?: WebSocketFactory
+	scheduler?: RoomScheduler
+}
+
+export type RoomChannel = { close: () => void }
+
+const defaultScheduler: RoomScheduler = {
+	schedule: (callback, delayMs) =>
+		globalThis.setTimeout(callback, delayMs) as unknown,
+	cancel: (handle) => globalThis.clearTimeout(handle as number),
+}
+
+function defaultUrl(roomId: string): string {
+	const location = globalThis.location
+	const protocol = location?.protocol === 'https:' ? 'wss:' : 'ws:'
+	const host = location?.host ?? 'localhost'
+	return `${protocol}//${host}/ws?room=${encodeURIComponent(roomId)}`
+}
+
+function parseEvent(raw: unknown): WsEvent | null {
+	if (typeof raw !== 'string') return null
+	try {
+		const parsed = JSON.parse(raw) as { type?: unknown }
+		return typeof parsed?.type === 'string' ? (parsed as WsEvent) : null
+	} catch {
+		return null
+	}
+}
+
+/**
+ * Host/audience WebSocket channel with auto-reconnect (1s, doubling, capped at
+ * 10s). Framework-free so it is unit-testable with an injected socket factory
+ * and scheduler; `useRoomChannel` binds it to a React component lifecycle.
+ */
+export function createRoomChannel(options: RoomChannelOptions): RoomChannel {
+	const factory: WebSocketFactory =
+		options.wsFactory ?? ((target) => new WebSocket(target))
+	const scheduler = options.scheduler ?? defaultScheduler
+	const url = options.url ?? defaultUrl(options.roomId)
+
+	let socket: WebSocketLike | null = null
+	let reconnectHandle: unknown = null
+	let attempt = 0
+	let closed = false
+	let openedOnce = false
+
+	function scheduleReconnect(): void {
+		if (closed) return
+		const delayMs = Math.min(INITIAL_BACKOFF_MS * 2 ** attempt, MAX_BACKOFF_MS)
+		attempt += 1
+		reconnectHandle = scheduler.schedule(connect, delayMs)
+	}
+
+	function connect(): void {
+		if (closed) return
+		const next = factory(url)
+		socket = next
+		next.onopen = () => {
+			attempt = 0
+			options.onStatusChange?.(true)
+			if (openedOnce) options.onReconnect?.()
+			openedOnce = true
+		}
+		next.onmessage = (event) => {
+			const parsed = parseEvent(event.data)
+			if (parsed) options.onEvent(parsed)
+		}
+		next.onclose = () => {
+			options.onStatusChange?.(false)
+			scheduleReconnect()
+		}
+	}
+
+	function close(): void {
+		if (closed) return
+		closed = true
+		if (reconnectHandle !== null) {
+			scheduler.cancel(reconnectHandle)
+			reconnectHandle = null
+		}
+		socket?.close()
+		options.onStatusChange?.(false)
+	}
+
+	connect()
+	return { close }
+}
+
+export function useRoomChannel(
+	roomId: string,
+	options: {
+		onEvent: (event: WsEvent) => void
+		onReconnect?: () => void
+	},
+): { connected: boolean } {
+	const [connected, setConnected] = useState(false)
+	const onEventRef = useRef(options.onEvent)
+	const onReconnectRef = useRef(options.onReconnect)
+
+	onEventRef.current = options.onEvent
+	onReconnectRef.current = options.onReconnect
+
+	useEffect(() => {
+		const channel = createRoomChannel({
+			roomId,
+			onEvent: (event) => onEventRef.current(event),
+			onReconnect: () => onReconnectRef.current?.(),
+			onStatusChange: setConnected,
+		})
+		return () => {
+			channel.close()
+		}
+	}, [roomId])
+
+	return { connected }
+}
