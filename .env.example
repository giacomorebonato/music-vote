DATABASE_URL=file:./dev.db
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# Bot prerender (optional; prod-only). Renders bot requests via the Lightpanda
# binary shipped by `@lightpanda/browser`'s postinstall. Leave both commented
# out to use the defaults (`SSR_CACHE_DIR` → a fresh mkdtemp dir,
# `LIGHTPANDA_EXECUTABLE_PATH` → `~/.cache/lightpanda-node/lightpanda`).
# SSR_CACHE_DIR=
# LIGHTPANDA_EXECUTABLE_PATH=

# LLM provider: `ollama` (default) or `mock` (scripted responses for tests)
LLM_PROVIDER=ollama

# Path to a `{ "responses": string[] }` fixture, read when LLM_PROVIDER=mock.
# Each provider instance re-reads it from index 0, so responses are deterministic.
LLM_MOCK_SCRIPT=

# Ollama endpoint (local dev server, or https://ollama.com for cloud)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag, e.g. llama3.1 (required when LLM_PROVIDER=ollama)
OLLAMA_MODEL=

# Ollama cloud subscription key; sent as `Authorization: Bearer <key>` when set
OLLAMA_API_KEY=

# Test-only: `1` shrinks the poll open window to 5s and clamps the poll interval
# minimum to 10s so the E2E cycle runs fast (see backend/polls/scheduler.ts).
MV_E2E_FAST=

# Dev-only quick testing: compress every room's poll interval DOWN to at most
# this many seconds (e.g. `MV_TEST_INTERVAL_SECS=10 bun run dev` polls roughly
# every 10s + open-window seconds, whatever the room was created with).
# Unset = room intervals untouched. NOTE: normal testing tweaks timings through
# the create-room form (poll interval + poll open window); these env vars are
# global escape hatches that also affect rooms created before the tweak.
MV_TEST_INTERVAL_SECS=

# Dev-only quick testing: override the per-room poll open window (create-room
# form default 45s) so the countdown after voting is shorter (e.g.
# `MV_TEST_POLL_OPEN_SECS=10 bun run dev` closes every poll 10s after it opens).
# Unset = per-room value wins.
MV_TEST_POLL_OPEN_SECS=